# ---- secrets and logins (never commit) ----
# Velona API key, Apify token
.env
.env.*
!.env.example
# OAuth tokens for Zepto / Swiggy Food / Instamart / Zomato: anyone with these can use your accounts
.tokens/
# Amazon Now logged-in browser profile (Brave/Chrome)
.browser/

# ---- local state ----
# Zepto device id, payment QR images
.state/
# LangGraph SQLite checkpoints (your conversations)
.checkpoints/
*.sqlite
*.sqlite3
*.sqlite-*
*.db

# ---- your real data from test runs ----
# raw app responses: contain your addresses, carts, order ids, Apify run data
probes/
tools_dump.json
*.log
# your saved places: addresses, Wi-Fi names, coordinates
places.yaml

# ---- Python ----
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini